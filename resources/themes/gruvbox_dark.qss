/*
 * =============================================================================
 * GRUVBOX DARK THEME
 * =============================================================================
 * 
 * Color Palette Reference:
 * -----------------------------------------------------------------------------
 * ACCENT COLORS:
 *   Rosewater:  #dc8a78    Flamingo:   #dd7878    Pink:       #ea76cb
 *   Mauve:      #8839ef    Red:        #fb4934    Maroon:     #e64553
 *   Peach:      #fe640b    Yellow:     #fabd2f    Green:      #b8bb26
 *   Teal:       #179299    Sky:        #04a5e5    Sapphire:   #209fb5
 *   Blue:       #83a598    Lavender:   #d3869b
 * 
 * TEXT COLORS:
 *   Text:       #ebdbb2    (primary text)
 *   Subtext1:   #d5c4a1    (secondary text)
 *   Subtext0:   #928374    (tertiary/muted text)
 * 
 * OVERLAY COLORS (for borders, disabled states, etc.):
 *   Overlay2:   #a89984
 *   Overlay1:   #d5c4a1
 *   Overlay0:   #928374
 * 
 * SURFACE COLORS (for elevated elements):
 *   Surface2:   #665c54
 *   Surface1:   #504945
 *   Surface0:   #3c3836
 * 
 * BASE COLORS (backgrounds):
 *   Base:       #282828    (main background)
 *   Mantle:     #32302f    (secondary background)
 *   Crust:      #1d2021    (tertiary background)
 * 
 * =============================================================================
 * THEME VARIABLES (adjust these to change the entire theme)
 * =============================================================================
 * 
 * Primary Accent:      Blue (#83a598)
 * Secondary Accent:    Lavender (#d3869b)
 * Success:             Green (#b8bb26)
 * Warning:             Yellow (#fabd2f)
 * Error/Destructive:   Red (#fb4934)
 *
 * =============================================================================
 */

/* @icons
   check: #282828;   (checkmark / radio dot - shown on the accent-filled box)
   arrow: #ebdbb2;   (arrows / branches - shown on the theme background)
*/


/* =============================================================================
 * GLOBAL DEFAULTS
 * =============================================================================
 */

* {
    font-family: "Segoe UI", "SF Pro Display", "Helvetica Neue", Arial, "DejaVu Sans", sans-serif;
    font-size: 10pt;
}

QWidget {
    background-color: #282828;
    color: #fbf1c7;
    selection-background-color: #d3869b;
    selection-color: #282828;
}

QWidget:disabled {
    color: #928374;
}


/* =============================================================================
 * MAIN WINDOW & CONTAINERS
 * =============================================================================
 */

QMainWindow {
    background-color: #282828;
}

QMainWindow::separator {
    background-color: #3c3836;
    width: 1px;
    height: 1px;
}

QMainWindow::separator:hover {
    background-color: #83a598;
}

QDialog {
    background-color: #282828;
}

QFrame {
    border: none;
}

QFrame[frameShape="4"],  /* HLine */
QFrame[frameShape="5"] { /* VLine */
    background-color: #3c3836;
    border: none;
    max-height: 1px;
    max-width: 1px;
}


/* =============================================================================
 * MENU BAR
 * =============================================================================
 */

QMenuBar {
    background-color: #32302f;
    color: #ebdbb2;
    border-bottom: 1px solid #3c3836;
    padding: 1px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 5px;
    border-radius: 4px;
    margin: 1px;
}

QMenuBar::item:selected {
    background-color: #3c3836;
}

QMenuBar::item:pressed {
    background-color: #504945;
}


/* =============================================================================
 * MENUS & CONTEXT MENUS
 * =============================================================================
 */

QMenu {
    background-color: #32302f;
    color: #ebdbb2;
    border: 1px solid #3c3836;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background-color: #83a598;
    color: #282828;
}

QMenu::item:disabled {
    color: #928374;
}

QMenu::separator {
    height: 1px;
    background-color: #3c3836;
    margin: 2px 4px;
}

QMenu::icon {
    margin-left: 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 6px;
}

QMenu::indicator:checked {
    image: url(__ICONDIR__/menu-check.svg);
}


/* =============================================================================
 * TOOLBAR
 * =============================================================================
 */

QToolBar {
    background-color: #32302f;
    border: none;
    border-bottom: 1px solid #3c3836;
    padding: 4px;
    spacing: 4px;
}

QToolBar::separator {
    background-color: #3c3836;
    width: 1px;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px;
    color: #ebdbb2;
}

QToolButton:hover {
    background-color: #3c3836;
}

QToolButton:pressed {
    background-color: #504945;
}

QToolButton:checked {
    background-color: #d3869b;
    color: #282828;
}


/* =============================================================================
 * STATUS BAR
 * =============================================================================
 */

QStatusBar {
    background-color: #32302f;
    color: #d5c4a1;
    border-top: 1px solid #3c3836;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 2px 8px;
    color: #d5c4a1;
}


/* =============================================================================
 * PUSH BUTTONS
 * =============================================================================
 */

QPushButton {
    background-color: #3c3836;
    color: #ebdbb2;
    border: 1px solid #504945;
    border-radius: 6px;
    padding: 6px 16px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #504945;
    border-color: #665c54;
}

QPushButton:pressed {
    background-color: #665c54;
}

QPushButton:disabled {
    background-color: #32302f;
    color: #928374;
    border-color: #3c3836;
}

/* Primary/Default Button */
QPushButton:default,
QPushButton[primary="true"] {
    background-color: #83a598;
    color: #282828;
    border-color: #83a598;
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    background-color: #94b4a7;
    border-color: #94b4a7;
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    background-color: #6d8e82;
}

/* Destructive/Danger Button */
QPushButton[destructive="true"] {
    background-color: #fb4934;
    color: #282828;
    border-color: #fb4934;
}

QPushButton[destructive="true"]:hover {
    background-color: #fc5f4c;
    border-color: #fc5f4c;
}

QPushButton[destructive="true"]:pressed {
    background-color: #e03a26;
}

/* Flat/Text Button */
QPushButton:flat {
    background-color: transparent;
    border: none;
}

QPushButton:flat:hover {
    background-color: #3c3836;
}


/* =============================================================================
 * LINE EDIT & TEXT INPUTS
 * =============================================================================
 */

QLineEdit {
    background-color: #32302f;
    color: #ebdbb2;
    border: 1px solid #504945;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #d3869b;
    selection-color: #282828;
}

QLineEdit:hover {
    border-color: #665c54;
}

QLineEdit:focus {
    border-color: #83a598;
    background-color: #282828;
}

QLineEdit:disabled {
    background-color: #1d2021;
    color: #928374;
    border-color: #3c3836;
}

QLineEdit[readOnly="true"] {
    background-color: #1d2021;
}

/* Placeholder text */
QLineEdit::placeholder {
    color: #d5c4a1;
}


/* =============================================================================
 * TEXT EDIT & PLAIN TEXT EDIT
 * =============================================================================
 */

QTextEdit,
QPlainTextEdit {
    background-color: #282828;
    color: #ebdbb2;
    border: 1px solid #504945;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #d3869b;
    selection-color: #282828;
}

QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #665c54;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #83a598;
}

QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #1d2021;
    color: #928374;
}


/* =============================================================================
 * SPIN BOX & DOUBLE SPIN BOX
 * =============================================================================
 */

QSpinBox,
QDoubleSpinBox {
    background-color: #32302f;
    color: #ebdbb2;
    border: 1px solid #504945;
    border-radius: 6px;
    padding: 4px 8px;
    padding-right: 20px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #665c54;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #83a598;
    background-color: #282828;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    border-left: 1px solid #504945;
    border-top-right-radius: 5px;
    background-color: #3c3836;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover {
    background-color: #504945;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed {
    background-color: #665c54;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border: none;
    border-left: 1px solid #504945;
    border-bottom-right-radius: 5px;
    background-color: #3c3836;
}

QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #504945;
}

QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: #665c54;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(__ICONDIR__/arrow-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(__ICONDIR__/arrow-down.svg);
    width: 10px;
    height: 10px;
}


/* =============================================================================
 * COMBO BOX
 * =============================================================================
 */

QComboBox {
    background-color: #32302f;
    color: #ebdbb2;
    border: 1px solid #504945;
    border-radius: 6px;
    padding: 6px 10px;
    padding-right: 28px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #665c54;
}

QComboBox:focus,
QComboBox:on {
    border-color: #83a598;
}

QComboBox:disabled {
    background-color: #1d2021;
    color: #928374;
    border-color: #3c3836;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    image: url(__ICONDIR__/arrow-down.svg);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #32302f;
    color: #ebdbb2;
    border: 1px solid #3c3836;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #83a598;
    selection-color: #282828;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3c3836;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #83a598;
    color: #282828;
}


/* =============================================================================
 * CHECK BOX
 * =============================================================================
 */

QCheckBox {
    color: #ebdbb2;
    spacing: 8px;
}

QCheckBox:disabled {
    color: #928374;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #665c54;
    background-color: #32302f;
}

QCheckBox::indicator:hover {
    border-color: #83a598;
    background-color: #1d2021;
}

QCheckBox::indicator:checked {
    background-color: #83a598;
    border-color: #83a598;
    image: url(__ICONDIR__/check.svg);
}

QCheckBox::indicator:disabled {
    background-color: #1d2021;
    border-color: #504945;
}

QCheckBox::indicator:checked:disabled {
    background-color: #928374;
    border-color: #928374;
}


/* =============================================================================
 * RADIO BUTTON
 * =============================================================================
 */

QRadioButton {
    color: #ebdbb2;
    spacing: 8px;
}

QRadioButton:disabled {
    color: #928374;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #665c54;
    background-color: #32302f;
}

QRadioButton::indicator:hover {
    border-color: #83a598;
    background-color: #1d2021;
}

QRadioButton::indicator:checked {
    background-color: #83a598;
    border-color: #83a598;
    image: url(__ICONDIR__/radio.svg);
}

QRadioButton::indicator:disabled {
    background-color: #1d2021;
    border-color: #504945;
}


/* =============================================================================
 * SLIDER
 * =============================================================================
 */

QSlider::groove:horizontal {
    height: 6px;
    background-color: #3c3836;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -6px 0;
    background-color: #83a598;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #94b4a7;
}

QSlider::handle:horizontal:pressed {
    background-color: #6d8e82;
}

QSlider::sub-page:horizontal {
    background-color: #83a598;
    border-radius: 3px;
}

QSlider::groove:vertical {
    width: 6px;
    background-color: #3c3836;
    border-radius: 3px;
}

QSlider::handle:vertical {
    width: 18px;
    height: 18px;
    margin: 0 -6px;
    background-color: #83a598;
    border-radius: 9px;
}

QSlider::handle:vertical:hover {
    background-color: #94b4a7;
}

QSlider::add-page:vertical {
    background-color: #83a598;
    border-radius: 3px;
}


/* =============================================================================
 * PROGRESS BAR
 * =============================================================================
 */

QProgressBar {
    background-color: #3c3836;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: #ebdbb2;
}

QProgressBar::chunk {
    background-color: #83a598;
    border-radius: 4px;
}


/* =============================================================================
 * TAB WIDGET & TAB BAR
 * =============================================================================
 */

QTabWidget::pane {
    border: 1px solid #3c3836;
    border-radius: 6px;
    background-color: #282828;
    margin-top: -1px;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: #32302f;
    color: #d5c4a1;
    border: 1px solid #3c3836;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:hover {
    background-color: #1d2021;
    color: #ebdbb2;
}

QTabBar::tab:selected {
    background-color: #282828;
    color: #83a598;
    border-bottom: 2px solid #83a598;
    margin-bottom: -1px;
}

QTabBar::tab:disabled {
    color: #928374;
}

/* Close button on tabs */
QTabBar::close-button {
    image: none;
    subcontrol-position: right;
}

QTabBar::close-button:hover {
    background-color: #fb4934;
    border-radius: 3px;
}


/* =============================================================================
 * TABLE VIEW & TABLE WIDGET
 * =============================================================================
 */

QTableView,
QTableWidget {
    background-color: #282828;
    alternate-background-color: #32302f;
    color: #fbf1c7;
    gridline-color: #3c3836;
    border: 1px solid #3c3836;
    border-radius: 6px;
    selection-background-color: #374b46;
    selection-color: #fbf1c7;
}

QTableView::item,
QTableWidget::item {
    padding: 2px 4px;
    border: none;
}

QTableView::item:hover,
QTableWidget::item:hover {
    background-color: #1d2021;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #374b46;
    color: #fbf1c7;
}

QTableView::item:focus,
QTableWidget::item:focus {
    background-color: #445d57;
    color: #fbf1c7;
    outline: none;
}

/* Corner button (top-left) */
QTableView QTableCornerButton::section,
QTableWidget QTableCornerButton::section {
    background-color: #32302f;
    border: none;
    border-right: 1px solid #3c3836;
    border-bottom: 1px solid #3c3836;
}

/* =============================================================================
 * STAR FILTER WIDGET
 * =============================================================================
 */

StarFilterWidget QLineEdit#searchEdit {
    border-radius: 6px;
    padding: 6px 10px;
}

FilterConditionRow {
    background-color: #32302f;
    border: 1px solid #3c3836;
    border-radius: 6px;
    margin: 1px 0;
}

FilterConditionRow QToolButton {
    background-color: transparent;
    border: 1px solid #504945;
    border-radius: 4px;
    font-size: 9pt;
    color: #ebdbb2;
}

FilterConditionRow QToolButton:hover {
    background-color: #3c3836;
}

FilterConditionRow QToolButton:checked {
    background-color: #83a598;
    color: #282828;
    border-color: #83a598;
}


/* =============================================================================
 * HEADER VIEW (Table & Tree headers)
 * =============================================================================
 */

QHeaderView {
    background-color: #32302f;
    border: none;
}

QHeaderView::section {
    background-color: #32302f;
    color: #ebdbb2;
    padding: 4px 6px;
    border: none;
    border-right: 1px solid #3c3836;
    border-bottom: 1px solid #3c3836;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #1d2021;
}

QHeaderView::section:pressed {
    background-color: #3c3836;
}

QHeaderView::section:checked {
    background-color: #504945;
}

/* Sort indicator */
QHeaderView::up-arrow {
    image: url(__ICONDIR__/arrow-up.svg);
    width: 10px;
    height: 10px;
    margin-left: 4px;
}

QHeaderView::down-arrow {
    image: url(__ICONDIR__/arrow-down.svg);
    width: 10px;
    height: 10px;
    margin-left: 4px;
}

/* =============================================================================
 * TREE VIEW & TREE WIDGET
 * =============================================================================
 */

QTreeView,
QTreeWidget {
    background-color: #282828;
    alternate-background-color: #32302f;
    color: #ebdbb2;
    border: 1px solid #3c3836;
    border-radius: 6px;
    selection-background-color: #d3869b;
    selection-color: #282828;
    outline: none;
}

QTreeView::item,
QTreeWidget::item {
    padding: 4px 8px;
    border: none;
}

QTreeView::item:hover,
QTreeWidget::item:hover {
    background-color: #1d2021;
}

QTreeView::item:selected,
QTreeWidget::item:selected {
    background-color: #d3869b;
    color: #282828;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:hover {
    background-color: #1d2021;
}

QTreeView::branch:selected {
    background-color: #d3869b;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(__ICONDIR__/branch-closed.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(__ICONDIR__/branch-open.svg);
}


/* =============================================================================
 * LIST VIEW & LIST WIDGET
 * =============================================================================
 */

QListView,
QListWidget {
    background-color: #282828;
    alternate-background-color: #32302f;
    color: #ebdbb2;
    border: 1px solid #3c3836;
    border-radius: 6px;
    selection-background-color: #d3869b;
    selection-color: #282828;
    outline: none;
}

QListView::item,
QListWidget::item {
    padding: 6px 10px;
    border: none;
    border-radius: 4px;
    margin: 1px 4px;
}

QListView::item:hover,
QListWidget::item:hover {
    background-color: #1d2021;
}

QListView::item:selected,
QListWidget::item:selected {
    background-color: #d3869b;
    color: #282828;
}


/* =============================================================================
 * SCROLL BAR
 * =============================================================================
 */

QScrollBar:horizontal {
    background-color: #32302f;
    height: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #665c54;
    min-width: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #928374;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #d5c4a1;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: #32302f;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #665c54;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #928374;
}

QScrollBar::handle:vertical:pressed {
    background-color: #d5c4a1;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    width: 0;
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}


/* =============================================================================
 * SPLITTER
 * =============================================================================
 */

QSplitter::handle {
    background-color: #3c3836;
}

QSplitter::handle:hover {
    background-color: #83a598;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}


/* =============================================================================
 * GROUP BOX
 * =============================================================================
 */

QGroupBox {
    background-color: #32302f;
    border: 1px solid #3c3836;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #32302f;
    color: #ebdbb2;
}


/* =============================================================================
 * LABELS
 * =============================================================================
 */

QLabel {
    color: #fbf1c7;
    background-color: transparent;
}

QLabel:disabled {
    color: #928374;
}

/* Heading styles - use with setProperty() or object names */
QLabel[heading="1"] {
    font-size: 24pt;
    font-weight: 700;
}

QLabel[heading="2"] {
    font-size: 18pt;
    font-weight: 600;
}

QLabel[heading="3"] {
    font-size: 14pt;
    font-weight: 600;
}

QLabel[subtext="true"] {
    color: #a89984;
}


/* =============================================================================
 * TOOLTIP
 * =============================================================================
 */

QToolTip {
    background-color: #32302f;
    color: #ebdbb2;
    border: 1px solid #3c3836;
    border-radius: 6px;
    padding: 6px 10px;
}


/* =============================================================================
 * MESSAGE BOX
 * =============================================================================
 */

QMessageBox {
    background-color: #282828;
}

QMessageBox QLabel {
    color: #ebdbb2;
}


/* =============================================================================
 * DOCK WIDGET
 * =============================================================================
 */

QDockWidget {
    color: #ebdbb2;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #32302f;
    padding: 8px;
    border-bottom: 1px solid #3c3836;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #3c3836;
    border-radius: 4px;
}


/* =============================================================================
 * WIZARD
 * =============================================================================
 */

QWizard {
    background-color: #282828;
}

QWizard QWidget {
    background-color: #282828;
}


/* =============================================================================
 * CALENDAR WIDGET
 * =============================================================================
 */

QCalendarWidget {
    background-color: #282828;
}

QCalendarWidget QToolButton {
    color: #ebdbb2;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: #3c3836;
}

QCalendarWidget QMenu {
    background-color: #32302f;
}

QCalendarWidget QSpinBox {
    background-color: #32302f;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #32302f;
    border-bottom: 1px solid #3c3836;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #ebdbb2;
    background-color: #282828;
    selection-background-color: #83a598;
    selection-color: #282828;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #928374;
}


/* =============================================================================
 * STACKED WIDGET
 * =============================================================================
 */

QStackedWidget {
    background-color: #282828;
}


/* =============================================================================
 * SPECIAL/CUSTOM WIDGET STYLES
 * =============================================================================
 */

/* Project cards (from ProjectSelectionView) */
ProjectCard {
    background-color: #282828;
    border: 1px solid #3c3836;
    border-radius: 10px;
}

ProjectCard:hover {
    background-color: #32302f;
    border-color: #665c54;
}

/* Error/Warning states */
QLineEdit[error="true"],
QTextEdit[error="true"],
QSpinBox[error="true"],
QComboBox[error="true"] {
    border-color: #fb4934;
}

QLabel[error="true"] {
    color: #fb4934;
}

QLabel[warning="true"] {
    color: #fabd2f;
}

QLabel[success="true"] {
    color: #b8bb26;
}

/* Links */
QLabel[link="true"] {
    color: #83a598;
}

QLabel[link="true"]:hover {
    color: #94b4a7;
    text-decoration: underline;
}